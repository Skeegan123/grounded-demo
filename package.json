{
  "name": "grounded",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-entry-bundle.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint",
    "import:document-evidence": "node scripts/import-reducto-document.mjs",
    "test": "vitest run && pnpm test:bundle",
    "test:bundle": "node --test scripts/check-entry-bundle.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "preview:lighthouse": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "prelighthouse:report": "node scripts/prepare-lighthouse-output.mjs",
    "lighthouse:report": "lighthouse http://127.0.0.1:4173 --preset=desktop --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path=artifacts/lighthouse/grounded --chrome-flags='--headless'",
    "lighthouse:baseline": "pnpm build && start-server-and-test preview:lighthouse http-get://127.0.0.1:4173 lighthouse:report"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "dexie": "^4.4.5",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.79.0",
    "pdfjs-dist": "6.3.289",
    "start-server-and-test": "^3.0.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
